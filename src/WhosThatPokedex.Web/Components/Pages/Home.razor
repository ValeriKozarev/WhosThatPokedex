@page "/"
@inject PokeApiClient PokeApiClient
@inject IJSRuntime JS

<PageTitle>WhosThatPokedex</PageTitle>

<h1>Who's That Pokémon?</h1>

@if (!isGameStarted)
{
    <p>Pick one or more generations:</p>

    @foreach (var gen in AllGenerations)
    {
        <label>
            <input type="checkbox"
                   checked="@selectedGenerations.Contains(gen.Id)"
                   @onchange="@(e => ToggleGeneration(gen.Id, (bool)e.Value!))" />
            @gen.Name
        </label>
        <br />
    }

    <button @onclick="StartGame" disabled="@(selectedGenerations.Count == 0)">Start Game</button>
}
else if (targetPokemon is null || generationGroups is null)
{
    <p>Loading...</p>
}
else
{
    <img src="@targetPokemon.Sprites.Other.OfficialArtwork.FrontDefault"
        alt="Mystery Pokémon"
        style="width: 300px; @(isRevealed ? "" : "filter: brightness(0);")" />
    <audio @ref="audioElementRef" src="@targetPokemon?.Cries.Latest" style="display:none"></audio>
    <button @onclick="PlayCry" disabled="@isCryOnCooldown">🔊 Hear its call</button>
    
    @if (isRevealed)
    {
        <p>@resultMessage</p>
        <button @onclick="@(() => isGameStarted = false)">Play Again</button>
    }
    else
    {
        <p>Guesses: <TierDots Total="3" Used="@(3 - attemptsRemaining)" Color="#4caf50" /></p>

        <p>
            Hints: <TierDots Total="3" Used="hintsUsed" />
            <button @onclick="UseNextHint" disabled="@(hintsUsed >= 3 || isHintLoading)">
                @(isHintLoading ? "Loading hint..." : "Get Hint")
            </button>
        </p>

        @foreach (var hint in revealedHints)
        {
            <p>💡 @hint</p>
        }

        <select @bind="selectedGuess">
            <option value="">-- pick a Pokémon --</option>
            @foreach (var group in generationGroups!)
            {
                <optgroup label="@group.Label">
                    @foreach (var name in group.Names)
                    {
                        <option value="@name">@name</option>
                    }
                </optgroup>
            }
        </select>

        <button @onclick="SubmitGuess" disabled="@string.IsNullOrEmpty(selectedGuess)">Guess</button>
    }
}

@code {
    private static readonly (int Id, string Name)[] AllGenerations =
    [
        (1, "Generation I"), (2, "Generation II"), (3, "Generation III"),
        (4, "Generation IV"), (5, "Generation V"), (6, "Generation VI"),
        (7, "Generation VII"), (8, "Generation VIII"), (9, "Generation IX"),
    ];

    private List<(string Label, List<string> Names)>? generationGroups;

    private HashSet<int> selectedGenerations = new();
    private bool isGameStarted;

    private PokemonResponse? targetPokemon;
    private string? targetGenerationLabel;
    private string selectedGuess = "";
    private int attemptsRemaining = 3;
    private bool isRevealed;
    private string resultMessage = "";

    private int hintsUsed;
    private List<string> revealedHints = new();
    private bool isHintLoading;

    private ElementReference audioElementRef;
    private IJSObjectReference? audioModule;
    private bool isCryOnCooldown;
    private CancellationTokenSource? cryCooldownCts;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            audioModule = await JS.InvokeAsync<IJSObjectReference>("import", "./js/audio.js");
        }
    }

    private void ToggleGeneration(int id, bool isChecked)
    {
        if (isChecked)
            selectedGenerations.Add(id);
        else
            selectedGenerations.Remove(id);
    }

    private async Task PlayCry()
    {
        if (audioModule is null || targetPokemon?.Cries.Latest is null) return;

        // cancel any still-running cooldown from a previous play so its delayed
        // completion can't incorrectly clear a newer, still-active cooldown
        cryCooldownCts?.Cancel();
        cryCooldownCts = new CancellationTokenSource();
        var token = cryCooldownCts.Token;

        isCryOnCooldown = true;
        await audioModule.InvokeVoidAsync("playAudio", audioElementRef);

        try
        {
            await Task.Delay(TimeSpan.FromSeconds(5), token);
            isCryOnCooldown = false;
        }
        catch (TaskCanceledException)
        {
            // superseded by a newer cooldown — do nothing
        }
    }

    private async Task StartGame()
    {
        isGameStarted = true;
        targetPokemon = null;
        targetGenerationLabel = null;
        generationGroups = null;
        isRevealed = false;
        resultMessage = "";
        selectedGuess = "";
        attemptsRemaining = 3;
        cryCooldownCts?.Cancel();
        isCryOnCooldown = false;
        hintsUsed = 0;
        revealedHints = new();

        var orderedGenerationIds = selectedGenerations.OrderBy(id => id).ToList();
        var fetchTasks = orderedGenerationIds.Select(id => PokeApiClient.GetPokemonForGenerationAsync(id));
        var results = await Task.WhenAll(fetchTasks);

        generationGroups = orderedGenerationIds
            .Zip(results, (id, result) => (
                Label: AllGenerations.First(g => g.Id == id).Name,
                Names: result.Pokemon.Select(p => p.Name).OrderBy(n => n).ToList()
            ))
            .ToList();

        var combinedPokemonWithGeneration = orderedGenerationIds
            .Zip(results, (id, result) => (Id: id, result.Pokemon))
            .SelectMany(x => x.Pokemon.Select(p => (
                Pokemon: p,
                GenerationLabel: AllGenerations.First(g => g.Id == x.Id).Name
            )))
            .ToList();

        var targetEntry = combinedPokemonWithGeneration[Random.Shared.Next(combinedPokemonWithGeneration.Count)];
        targetPokemon = targetEntry.Pokemon;
        targetGenerationLabel = targetEntry.GenerationLabel;
    }

    private void SubmitGuess()
    {
        if (string.Equals(selectedGuess, targetPokemon!.Name, StringComparison.OrdinalIgnoreCase))
        {
            isRevealed = true;
            resultMessage = $"Correct! It's {targetPokemon.Name}!";
            return;
        }

        attemptsRemaining--;

        if (attemptsRemaining <= 0)
        {
            isRevealed = true;
            resultMessage = $"Out of guesses! It was {targetPokemon.Name}.";
        }
    }

    private async Task UseNextHint()
    {
        if (hintsUsed >= 3 || targetPokemon is null || isHintLoading) return;

        isHintLoading = true;
        var tierBeingRevealed = hintsUsed + 1;

        var hintText = tierBeingRevealed switch
        {
            1 => $"Region/Generation: {targetGenerationLabel}",
            2 => await GetEvolutionHintTextAsync(),
            3 => $"Type(s): {string.Join(", ", targetPokemon.Types.OrderBy(t => t.Slot).Select(t => t.Type.Name))}",
            _ => "No more hints."
        };

        revealedHints.Add(hintText);
        hintsUsed++;
        isHintLoading = false;
    }

    private async Task<string> GetEvolutionHintTextAsync()
    {
        var stage = await PokeApiClient.GetEvolutionStageAsync(targetPokemon!);

        return stage switch
        {
            EvolutionStage.DoesNotEvolve => "This Pokémon does not evolve.",
            EvolutionStage.BaseWithMultipleEvolutionsAhead => "This is a base-form Pokémon that evolves multiple times.",
            EvolutionStage.BaseWithOneEvolutionAhead => "This is a base-form Pokémon that evolves once.",
            EvolutionStage.MidEvolutionCanEvolveFurther => "This is an evolved form, but it can still evolve further.",
            EvolutionStage.FullyEvolved => "This is a fully evolved Pokémon.",
            _ => "Unknown evolution stage.",
        };
    }
}