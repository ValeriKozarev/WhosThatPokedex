@page "/"
@inject PokeApiClient PokeApiClient
@inject IJSRuntime JS

<PageTitle>WhosThatPokedex</PageTitle>

<div class="pkd-app">
    <div class="pkd-header">
        <div class="pkd-ball"></div>
        <h1 class="pkd-title">WHO'S THAT<br /><span class="accent">POKEDEX</span></h1>
    </div>

    @if (!isGameStarted)
    {
        <div class="pkd-panel pkd-copy">PICK YOUR REGIONS,<br />THEN HIT START! ▶</div>

        <div class="pkd-gen-grid">
            @foreach (var gen in AllGenerations)
            {
                <button type="button"
                        class="pkd-gen-card @(selectedGenerations.Contains(gen.Id) ? "active" : "")"
                        @onclick="@(() => ToggleGeneration(gen.Id))">
                    <span class="pkd-gen-label">@gen.Region.ToUpperInvariant()</span>
                    <span class="pkd-gen-sub">@gen.Short · @gen.Count</span>
                </button>
            }
        </div>

        <p class="pkd-pool-note">
            @(selectedGenerations.Count == 0
                ? "NOTHING PICKED YET"
                : $"POOL: {selectedGenerations.Sum(id => AllGenerations.First(g => g.Id == id).Count)} POKÉMON")
        </p>

        <button class="pkd-btn" @onclick="StartGame" disabled="@(selectedGenerations.Count == 0)">
            @(selectedGenerations.Count == 0 ? "PICK A REGION" : "START! ▶")
        </button>
    }
    else if (targetPokemon is null || generationGroups is null)
    {
        <div class="pkd-loading">
            <div class="pkd-spinner"><div class="pkd-spinner-inner"></div></div>
            <div class="pkd-loading-label">CATCHING DATA...</div>
            <div class="pkd-progress-track">
                <div class="pkd-progress-fill" style="width:@(LoadingPercent)%"></div>
            </div>
            <div class="pkd-progress-label">@Math.Round(LoadingPercent)% · @loadingFetched / @loadingTotal</div>
        </div>
    }
    else if (isRevealed)
    {
        <div class="pkd-reveal-panel @(hasWon ? "win" : "lose")">
            <img src="@targetPokemon.Sprites.Other.OfficialArtwork.FrontDefault" alt="@targetPokemon.Name" />
        </div>
        <div class="pkd-panel">
            <div class="pkd-reveal-head">@(hasWon ? "IT'S..." : "OUT OF GUESSES! IT WAS...")</div>
            <div class="pkd-reveal-name">@targetPokemon.Name</div>
            <div class="pkd-reveal-meta">
                @targetGeneration?.Short · @string.Join(" / ", targetPokemon.Types.OrderBy(t => t.Slot).Select(t => t.Type.Name))
            </div>
        </div>
        <button class="pkd-btn" style="margin-top:16px" @onclick="@(() => isGameStarted = false)">PLAY AGAIN ▶</button>
    }
    else
    {
        <div class="pkd-silhouette-panel">
            <img src="@targetPokemon.Sprites.Other.OfficialArtwork.FrontDefault" alt="Mystery Pokémon" style="filter: brightness(0);" />
            <audio @ref="audioElementRef" src="@targetPokemon?.Cries.Latest" style="display:none"></audio>
            <button class="pkd-btn pkd-btn-small pkd-btn-yellow pkd-cry-btn" @onclick="PlayCry" disabled="@isCryOnCooldown">♪ CRY</button>
        </div>

        <div class="pkd-stats-row">
            <div class="pkd-stat-box pkd-panel">
                <div class="pkd-stat-label">GUESSES</div>
                <TierDots Total="3" Used="@(3 - attemptsRemaining)" />
            </div>
            <div class="pkd-stat-box pkd-panel">
                <div class="pkd-stat-label">HINTS</div>
                <div class="pkd-hint-row">
                    <TierDots Total="3" Used="hintsUsed" />
                    <button class="pkd-btn pkd-btn-small pkd-btn-yellow" @onclick="UseNextHint" disabled="@(hintsUsed >= 3 || isHintLoading)">
                        @(isHintLoading ? "..." : "?")
                    </button>
                </div>
            </div>
        </div>

        <div class="pkd-hints-list">
            @foreach (var hint in revealedHints)
            {
                <div class="pkd-hint-box">@hint.ToUpperInvariant()</div>
            }
            @if (tauntMessage is not null)
            {
                <div class="pkd-taunt-box">@tauntMessage</div>
            }
        </div>

        <div class="pkd-guess-row">
            <PokemonPicker Groups="generationGroups!" @bind-Value="selectedGuess" />
        </div>

        <button class="pkd-btn pkd-btn-success" @onclick="SubmitGuess" disabled="@string.IsNullOrEmpty(selectedGuess)">GUESS!</button>
    }
</div>

@code {
    private static readonly (int Id, string Name, string Short, string Region, int Count)[] AllGenerations =
    [
        (1, "Generation I", "GEN I", "Kanto", 151),
        (2, "Generation II", "GEN II", "Johto", 100),
        (3, "Generation III", "GEN III", "Hoenn", 135),
        (4, "Generation IV", "GEN IV", "Sinnoh", 107),
        (5, "Generation V", "GEN V", "Unova", 156),
        (6, "Generation VI", "GEN VI", "Kalos", 72),
        (7, "Generation VII", "GEN VII", "Alola", 88),
        (8, "Generation VIII", "GEN VIII", "Galar", 96),
        (9, "Generation IX", "GEN IX", "Paldea", 120),
    ];

    private static readonly string[] Taunts =
    [
        "Not even close, trainer.",
        "Hmm. Try again.",
        "So close! One left...",
    ];

    private List<(string Label, List<string> Names)>? generationGroups;

    private HashSet<int> selectedGenerations = new();
    private bool isGameStarted;

    private PokemonResponse? targetPokemon;
    private (int Id, string Name, string Short, string Region, int Count)? targetGeneration;
    private string selectedGuess = "";
    private int attemptsRemaining = 3;
    private bool isRevealed;
    private bool hasWon;
    private string? tauntMessage;

    private int hintsUsed;
    private List<string> revealedHints = new();
    private bool isHintLoading;

    private readonly Dictionary<int, PokemonFetchProgress> progressByGeneration = new();
    private int loadingFetched;
    private int loadingTotal;
    private double LoadingPercent => loadingTotal == 0 ? 0 : (double)loadingFetched / loadingTotal * 100;

    private ElementReference audioElementRef;
    private IJSObjectReference? audioModule;
    private bool isCryOnCooldown;
    private CancellationTokenSource? cryCooldownCts;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            audioModule = await JS.InvokeAsync<IJSObjectReference>("import", "./js/audio.js");
        }
    }

    private void ToggleGeneration(int id)
    {
        if (!selectedGenerations.Add(id))
            selectedGenerations.Remove(id);
    }

    private async Task PlayCry()
    {
        if (audioModule is null || targetPokemon?.Cries.Latest is null) return;

        // cancel any still-running cooldown from a previous play so its delayed
        // completion can't incorrectly clear a newer, still-active cooldown
        cryCooldownCts?.Cancel();
        cryCooldownCts = new CancellationTokenSource();
        var token = cryCooldownCts.Token;

        isCryOnCooldown = true;
        await audioModule.InvokeVoidAsync("playAudio", audioElementRef);

        try
        {
            await Task.Delay(TimeSpan.FromSeconds(5), token);
            isCryOnCooldown = false;
        }
        catch (TaskCanceledException)
        {
            // superseded by a newer cooldown — do nothing
        }
    }

    // Reports one generation's progress into the shared totals. Multiple of these
    // can be in flight concurrently (one per selected generation), but Progress<T>
    // captures Blazor Server's own SynchronizationContext when constructed in
    // StartGame, so every callback — no matter which generation's fetch raised it —
    // gets marshaled back onto the same circuit and runs one at a time. That's what
    // makes it safe to mutate a plain Dictionary here instead of a ConcurrentDictionary.
    private void ReportGenerationProgress(int generationId, PokemonFetchProgress progress)
    {
        progressByGeneration[generationId] = progress;
        loadingTotal = progressByGeneration.Values.Sum(p => p.TotalPokemon);
        loadingFetched = progressByGeneration.Values.Sum(p => p.FetchedPokemon + p.FailedPokemon);
        StateHasChanged();
    }

    private async Task StartGame()
    {
        isGameStarted = true;
        targetPokemon = null;
        targetGeneration = null;
        generationGroups = null;
        isRevealed = false;
        hasWon = false;
        tauntMessage = null;
        selectedGuess = "";
        attemptsRemaining = 3;
        cryCooldownCts?.Cancel();
        isCryOnCooldown = false;
        hintsUsed = 0;
        revealedHints = new();
        progressByGeneration.Clear();
        loadingFetched = 0;
        loadingTotal = 0;

        var orderedGenerationIds = selectedGenerations.OrderBy(id => id).ToList();
        var fetchTasks = orderedGenerationIds.Select(id =>
        {
            var progress = new Progress<PokemonFetchProgress>(p => ReportGenerationProgress(id, p));
            return PokeApiClient.GetPokemonForGenerationAsync(id, progress);
        });
        var results = await Task.WhenAll(fetchTasks);

        generationGroups = orderedGenerationIds
            .Zip(results, (id, result) => (
                Label: AllGenerations.First(g => g.Id == id).Name,
                Names: result.Pokemon.Select(p => p.Name).OrderBy(n => n).ToList()
            ))
            .ToList();

        var combinedPokemonWithGeneration = orderedGenerationIds
            .Zip(results, (id, result) => (Id: id, result.Pokemon))
            .SelectMany(x => x.Pokemon.Select(p => (
                Pokemon: p,
                Generation: AllGenerations.First(g => g.Id == x.Id)
            )))
            .ToList();

        var targetEntry = combinedPokemonWithGeneration[Random.Shared.Next(combinedPokemonWithGeneration.Count)];
        targetPokemon = targetEntry.Pokemon;
        targetGeneration = targetEntry.Generation;
    }

    private void SubmitGuess()
    {
        if (string.Equals(selectedGuess, targetPokemon!.Name, StringComparison.OrdinalIgnoreCase))
        {
            isRevealed = true;
            hasWon = true;
            return;
        }

        attemptsRemaining--;

        if (attemptsRemaining <= 0)
        {
            isRevealed = true;
            hasWon = false;
        }
        else
        {
            var tauntIndex = Math.Clamp(2 - attemptsRemaining, 0, Taunts.Length - 1);
            tauntMessage = Taunts[tauntIndex];
        }
    }

    private async Task UseNextHint()
    {
        if (hintsUsed >= 3 || targetPokemon is null || isHintLoading) return;

        isHintLoading = true;
        var tierBeingRevealed = hintsUsed + 1;

        var hintText = tierBeingRevealed switch
        {
            1 => $"Region: {targetGeneration?.Region} ({targetGeneration?.Short})",
            2 => await GetEvolutionHintTextAsync(),
            3 => $"Type: {string.Join(" / ", targetPokemon.Types.OrderBy(t => t.Slot).Select(t => t.Type.Name))}",
            _ => "No more hints."
        };

        revealedHints.Add(hintText);
        hintsUsed++;
        isHintLoading = false;
    }

    private async Task<string> GetEvolutionHintTextAsync()
    {
        var stage = await PokeApiClient.GetEvolutionStageAsync(targetPokemon!);

        return stage switch
        {
            EvolutionStage.DoesNotEvolve => "This Pokémon does not evolve.",
            EvolutionStage.BaseWithMultipleEvolutionsAhead => "Base form. It evolves multiple times.",
            EvolutionStage.BaseWithOneEvolutionAhead => "Base form. It evolves once.",
            EvolutionStage.MidEvolutionCanEvolveFurther => "Evolved form, but can still evolve further.",
            EvolutionStage.FullyEvolved => "This is a fully evolved Pokémon.",
            _ => "Unknown evolution stage.",
        };
    }
}
