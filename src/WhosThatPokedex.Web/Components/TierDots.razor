@* A row of square pixel-style dots showing how many of a limited resource
   (hints, guesses) have been used out of a total. Available ones are red,
   used ones fade to tan — matches the "cartridge" theme's dot language. *@

<span>
    @for (var i = 0; i < Total; i++)
    {
        // not capturing 'i' in a delegate here — used inline per render, so the
        // closure-capture concern that matters for delegates doesn't apply
        <span class="pkd-dot @(i < Used ? "off" : "on")"></span>
    }
</span>

@code {
    [Parameter]
    public int Total { get; set; } = 3;

    [Parameter]
    public int Used { get; set; }
}
