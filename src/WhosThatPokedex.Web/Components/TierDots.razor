@* A row of colored/greyed dots showing how many of a limited resource (hints, guesses)
   have been used out of a total. Used ones (leftmost) are grey; remaining ones stay colored. *@

<span>
    @for (var i = 0; i < Total; i++)
    {
        // not capturing 'i' in a delegate here — used inline per render, so the
        // closure-capture concern that matters for delegates doesn't apply
        <span style="display:inline-block; width:14px; height:14px; border-radius:50%;
                     margin-left:4px; background-color:@(i < Used ? "#ccc" : Color);"></span>
    }
</span>

@code {
    [Parameter]
    public int Total { get; set; } = 3;

    [Parameter]
    public int Used { get; set; }

    [Parameter]
    public string Color { get; set; } = "gold";
}
